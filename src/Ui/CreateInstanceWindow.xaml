<Window x:Class="MultiHost.CreateInstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="创建实例" Width="560" Height="500" MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="创建实例" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="将模板复制到工作区的独立文件夹。" Opacity="0.65" Margin="0,4,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="CreateForm" Margin="0,0,8,0">
                <TextBlock Text="显示名称" Margin="0,0,0,5"/>
                <TextBox x:Name="RemarkBox" AutomationProperties.Name="新实例显示名称"/>
                <TextBlock Text="实例文件夹名" Margin="0,14,0,5"/>
                <TextBox x:Name="FolderBox" AutomationProperties.Name="新实例文件夹名"/>
                <TextBlock Text="启动程序" Margin="0,14,0,5"/>
                <ComboBox x:Name="ExeCombo" AutomationProperties.Name="新实例启动程序"/>
                <TextBlock x:Name="TemplateHint" Opacity="0.65" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock x:Name="TemplatePath" Opacity="0.65" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <Button Content="刷新模板程序" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,4" Click="RefreshTemplateBtn_Click"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="FeedbackText" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CloseBtn" Content="取消" MinWidth="80" Padding="14,6" Margin="0,0,8,0" Click="CloseBtn_Click"/>
                <Button x:Name="CancelCreateBtn" Content="取消复制" Padding="14,6" Margin="0,0,8,0" Visibility="Collapsed" Click="CancelCreateBtn_Click"/>
                <Button x:Name="CreateBtn" Content="创建实例" IsDefault="True" Padding="14,6" Click="CreateBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
