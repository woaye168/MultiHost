<Window x:Class="MultiHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MultiHost · 应用多开管理器" Width="1280" Height="820" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="16,12,16,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button x:Name="SyncBtn" Content="开启同步" Padding="12,5" Margin="0,0,16,0" Click="SyncBtn_Click"/>
                <Button x:Name="BatchStartBtn" Content="启动勾选" Padding="12,5" Margin="0,0,6,0" Click="BatchStartBtn_Click"/>
                <Button x:Name="BatchStopBtn" Content="停止勾选" Padding="12,5" Margin="0,0,16,0" Click="BatchStopBtn_Click"/>
                <Button x:Name="CreateBtn" Content="创建" Padding="12,5" Margin="0,0,6,0" Click="CreateBtn_Click"/>
                <Button x:Name="SettingsBtn" Content="设置" Padding="12,5" Margin="0,0,6,0" Click="SettingsBtn_Click"/>
                <Button Content="运行日志" Padding="12,5" Click="OpenLogBtn_Click"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="MultiHost" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="WorkspaceSummary" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" Margin="8,0,8,4">
            <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                          SizeChanged="CardsScroll_SizeChanged" CanContentScroll="False">
                <WrapPanel x:Name="InstanceGrid" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </ScrollViewer>
            <TextBlock x:Name="EmptyInstancesHint" Text="还没有实例。先在「设置」选择工作区和模板目录，再点击「创建」。"
                       TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Margin="32" Opacity="0.7" IsHitTestVisible="False"/>
        </Grid>
        <Border Grid.Row="2" Padding="16,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
            <TextBlock x:Name="StatusText" Text="就绪" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </Border>
    </Grid>
</Window>

