<UserControl x:Class="MultiHost.InstanceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="6" BorderThickness="1" CornerRadius="6"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Padding="10,8" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
                <!-- 头部单行：勾选 + 标题 + 状态（紧随标题），按钮组推到最右 -->
                <DockPanel VerticalAlignment="Center">
                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button x:Name="StartBtn" Content="启动" Padding="10,3" Margin="0,0,5,0" Click="StartBtn_Click"/>
                        <Button x:Name="StopBtn" Content="停止" Padding="10,3" Margin="0,0,5,0" Click="StopBtn_Click"/>
                        <Button Content="配置" Padding="10,3" Margin="0,0,12,0" Click="ConfigureBtn_Click"/>
                        <Button x:Name="ActivateBtn" Content="键盘" ToolTip="把键盘输入切到此应用（鼠标点击后焦点可能丢失，点这里恢复键盘控制）" Padding="10,3" Margin="0,0,5,0" Click="ActivateBtn_Click"/>
                        <Button x:Name="PopOutBtn" Content="弹出" Padding="10,3" Margin="0,0,5,0" Click="PopOutBtn_Click"/>
                        <Button x:Name="ReEmbedBtn" Content="收回" Padding="10,3" Click="ReEmbedBtn_Click"/>
                    </WrapPanel>
                    <CheckBox x:Name="SelectedCheck" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"
                              Margin="0,0,10,0" AutomationProperties.Name="勾选实例"/>
                    <TextBlock Text="{Binding Config.Remark}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Config.FolderName}"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.75" VerticalAlignment="Center"
                               Margin="8,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"/>
                </DockPanel>
            </Border>
            <ContentControl x:Name="WindowContent" Grid.Row="1" Margin="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
    </Border>
</UserControl>
