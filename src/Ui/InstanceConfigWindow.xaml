<Window x:Class="MultiHost.InstanceConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="实例配置" Width="560" Height="620" MinWidth="460" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="启动配置" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="FolderHint" Opacity="0.65" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="显示名称" Margin="0,0,0,5"/>
                <TextBox x:Name="InstanceRemarkBox" AutomationProperties.Name="实例显示名称"/>
                <TextBlock Text="启动程序（相对实例目录）" Margin="0,14,0,5"/>
                <ComboBox x:Name="InstanceExeBox" IsEditable="True" AutomationProperties.Name="实例启动程序"/>
                <TextBlock Text="启动参数" Margin="0,14,0,5"/>
                <TextBox x:Name="ExtraArgsBox" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="启动参数"/>
                <CheckBox x:Name="EmbedCheck" Content="启动后内嵌窗口" Margin="0,16,0,12"/>
                <TextBlock Text="启动尺寸参数" FontWeight="SemiBold"/>
                <TextBlock Text="仅在下方勾选后传入程序；内嵌时随卡片调整，弹出时恢复原窗口尺寸。" Opacity="0.65" TextWrapping="Wrap" Margin="0,4,0,8"/>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="宽" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="WidthBox" Width="90" AutomationProperties.Name="启动窗口宽度参数"/>
                    <TextBlock Text="× 高" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBox x:Name="HeightBox" Width="90" AutomationProperties.Name="启动窗口高度参数"/>
                </WrapPanel>
                <CheckBox x:Name="SizeArgsCheck" Margin="0,12,0,0">
                    <TextBlock Text="附加 -width / -height 参数（仅支持此参数的应用）" TextWrapping="Wrap"/>
                </CheckBox>
                <TextBlock Text="保存后将在下次启动时生效。" Opacity="0.65" Margin="0,16,0,8"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="FeedbackText" Foreground="IndianRed" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" IsCancel="True" MinWidth="80" Padding="14,6" Margin="0,0,8,0"/>
                <Button x:Name="SaveCfgBtn" Content="保存配置" IsDefault="True" Padding="14,6" Click="SaveCfgBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
